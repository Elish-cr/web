<article class="post-card">
  <a href="{{ post.url }}">
    {%- if post.data.image %}
    {% picture post.data.image, post.data.imageAlt or post.data.title, "(max-width: 860px) 100vw, 360px", 'loading="lazy"' %}
    {%- else %}
    <div class="post-card-blank" aria-hidden="true"></div>
    {%- endif %}
    <div class="post-card-body">
      <h3>{{ post.data.title }}</h3>
      <p>{{ post.data.description | excerpt(120) }}</p>
    </div>
  </a>
</article>
