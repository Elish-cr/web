{%- from "icons.njk" import icon -%}
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} | {{ site.name }} - {{ site.doctor }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
  <meta property="og:locale" content="he_IL">
  <meta property="og:site_name" content="{{ site.name }} - {{ site.doctor }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or '/images/clinic-room.jpg' }}">
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  {%- if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "MedicalClinic",
    "name": "{{ site.name }} - {{ site.doctor }}",
    "url": "{{ site.url }}",
    "telephone": "+972559526838",
    "image": "{{ site.url }}/images/clinic-room.jpg",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.street }}",
      "addressLocality": "{{ site.city }}",
      "addressCountry": "IL"
    },
    "sameAs": ["{{ site.instagram }}", "{{ site.facebook }}"]
  }
  </script>
  {%- endif %}
</head>
<body>
  <a class="skip" href="#main">דילוג לתוכן</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="btn btn-peach header-book" href="{{ site.bookingHeader }}" target="_blank" rel="noopener">קביעת טיפול</a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav" aria-label="תפריט">
        <span></span><span></span><span></span>
      </button>
      <nav id="nav" class="nav" aria-label="ניווט ראשי">
        {%- set links = [["/", "בית"], ["/about/", "אודות"], ["/treatments/", "טיפולים"], ["/blog/", "מאמרים"], ["/testimonials/", "לקוחות מספרים"]] %}
        <ul>
          {%- for l in links %}
          <li><a href="{{ l[0] }}"{% if page.url == l[0] or (l[0] != "/" and page.url.startsWith(l[0])) %} aria-current="page"{% endif %}>{{ l[1] }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <a class="logo" href="/" aria-label="{{ site.name }} - דף הבית">
        <img src="/images/logo.png" alt="Trail of Silk - Dr. Eli Shezifi" width="92" height="82">
      </a>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "contact.njk" %}

  <footer class="site-footer">
    <div class="wrap">
      <p>© {{ year }}{{ site.name }} · {{ site.doctor }} · {{ site.address }}</p>
    </div>
  </footer>

  <a class="wa-float" href="{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="שליחת הודעה בוואטסאפ">{{ icon("whatsapp", 30) }}</a>

  <script>
    const t = document.querySelector(".menu-toggle");
    t.addEventListener("click", () => {
      const open = document.body.classList.toggle("nav-open");
      t.setAttribute("aria-expanded", open);
    });
  </script>
</body>
</html>
