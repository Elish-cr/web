{%- from "icons.njk" import icon -%}
<section class="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-card stock">
      <h2 id="contact-title" class="visually-hidden">יצירת קשר</h2>
      <dl class="contact-facts">
        <div><dt>טלפון</dt><dd><a href="{{ site.phoneLink }}" dir="ltr">{{ site.phone }}</a></dd></div>
        <div><dt>כתובת</dt><dd>{{ site.street }},<br>{{ site.city }}</dd></div>
      </dl>
      <div class="contact-actions">
        <a class="btn" href="{{ site.booking }}" target="_blank" rel="noopener">קביעת טיפול</a>
        <a class="link" href="{{ site.whatsapp }}" target="_blank" rel="noopener">צרו איתי קשר</a>
      </div>
      <div class="contact-social">
        <h3>עקבו ברשתות</h3>
        <div class="social">
          <a href="{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="וואטסאפ">{{ icon("whatsapp", 24) }}</a>
          <a href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="אינסטגרם">{{ icon("instagram", 24) }}</a>
          <a href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="פייסבוק">{{ icon("facebook", 24) }}</a>
        </div>
      </div>
    </div>
    <div class="contact-photo">
      {% picture "/images/doctor-smile.jpg", site.doctor, "(max-width: 960px) 100vw, 400px", 'loading="lazy"' %}
    </div>
    <div class="contact-map">
      <iframe title="מפה: {{ site.address }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        src="https://maps.google.com/maps?q=%D7%97%D7%99%D7%99%D7%9D%20%D7%94%D7%A8%D7%A6%D7%95%D7%92%2029%20%D7%A8%D7%90%D7%A9%20%D7%94%D7%A2%D7%99%D7%9F&hl=he&z=15&output=embed"></iframe>
    </div>
  </div>
</section>
